---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { bundles, type PublicBundle } from '../../lib/content';
import type { BlitzData } from '../../lib/blitz/game';

export const getStaticPaths = (() =>
  bundles()
    .filter((b) => b.formulas.length > 0)
    .map((b) => ({ params: { exam: b.exam.id }, props: { b } }))) satisfies GetStaticPaths;

interface Props {
  b: PublicBundle;
}

const { b } = Astro.props;
const sectionOf = new Map(
  b.roadmap.sections.flatMap((s, i) => s.topics.map((t) => [t.id, { i, title: t.title }] as const)),
);
const data: BlitzData = {
  exam: b.exam.id,
  sections: b.roadmap.sections.map((s) => ({ id: s.id, title: s.title })),
  formulas: b.formulas.map((f) => {
    const where = sectionOf.get(f.topic);
    if (!where) throw new Error(`formula «${f.title}»: unknown topic ${f.topic}`);
    return { s: where.i, topic: where.title, title: f.title, ask: f.ask, also: f.also };
  }),
};
const counts = data.sections
  .map((s, i) => ({ ...s, n: data.formulas.filter((f) => f.s === i).length }))
  .filter((s) => s.n > 0);
const symbols = ['²', '³', '^', '√', '·', '/', '(', ')', '_', 'π', 'Δ'];
const greek = ['α', 'β', 'γ', 'ε', 'η', 'θ', 'λ', 'μ', 'ν', 'ρ', 'σ', 'τ', 'φ', 'ω', 'Φ', 'Γ'];
const functions = ['sin', 'cos', 'tg', 'ctg'];
---

<Base title={`Блиц — ${b.exam.title}`} description="Блиц по формулам физики: успейте дописать как можно больше формул за минуту">
  <formula-blitz>
    <script type="application/json" class="blitz-data" set:html={JSON.stringify(data)} />

    <section class="b-start">
      <header class="page-head">
        <div>
          <div class="eyebrow">Блиц</div>
          <h1>Формулы на скорость</h1>
          <p class="muted">
            Допишите правую часть формулы, пока идёт время. Серия верных ответов подряд
            приносит бонусные секунды.
          </p>
        </div>
      </header>

      <div class="card setup">
        <fieldset>
          <legend>Раздел</legend>
          <div class="options">
            <label class="opt">
              <input type="radio" name="section" value="all" checked />
              <span>Все разделы <small>{data.formulas.length}</small></span>
            </label>
            {
              counts.map((s) => (
                <label class="opt">
                  <input type="radio" name="section" value={s.id} />
                  <span>
                    {s.title} <small>{s.n}</small>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <fieldset>
          <legend>Время</legend>
          <div class="options">
            <label class="opt"><input type="radio" name="duration" value="60" checked /><span>1 минута</span></label>
            <label class="opt"><input type="radio" name="duration" value="120" /><span>2 минуты</span></label>
            <label class="opt"><input type="radio" name="duration" value="180" /><span>3 минуты</span></label>
          </div>
        </fieldset>
        <div class="go-row">
          <button type="button" class="btn go start">Старт</button>
          <p class="record muted" aria-live="polite"></p>
        </div>
      </div>

      <details class="card howto">
        <summary>Как вводить формулы</summary>
        <ul>
          <li>
            Буквы подряд перемножаются: <code>mgh</code> — это <i>m·g·h</i>. Можно и со знаком:
            <code>m*g*h</code>.
          </li>
          <li>
            Дробь — косой чертой: <code>mv^2/2</code>. Всё, что записано подряд, попадает в
            числитель или знаменатель целиком; сумму в знаменателе берите в скобки:
            <code>q/(4πε0r^2)</code> или <code>U/(R+r)</code>.
          </li>
          <li>
            Индекс — цифрой или через подчёркивание: <code>v0</code>, <code>v_0</code>,
            <code>F_тр</code>. Индексы и греческие буквы проще брать из панели под полем.
          </li>
          <li>
            Степень — <code>^</code> или кнопка <code>²</code>; корень — <code>√(…)</code> или
            <code>sqrt(…)</code>; функции — <code>sin(α)</code>.
          </li>
          <li>
            Засчитывается любая равносильная запись: <code>ma</code>, <code>am</code> и
            <code>m·a</code> — одно и то же. Над полем видно, как прочитан ответ.
          </li>
        </ul>
      </details>
    </section>

    <section class="b-play" hidden>
      <div class="hud" role="group" aria-label="Счёт">
        <div class="stat score" title="Верных ответов">
          <span class="ico" aria-hidden="true">✓</span><b class="v">0</b>
          <span class="visually-hidden">верных ответов</span>
        </div>
        <div class="timer" role="timer" aria-label="Осталось времени">
          <span class="clock">1:00</span>
          <span class="track" aria-hidden="true"><span class="fill"></span></span>
          <span class="bonus" aria-hidden="true"></span>
        </div>
        <div class="stat streak" title="Серия верных ответов подряд">
          <span class="ico" aria-hidden="true">🔥</span><b class="v">0</b>
          <span class="visually-hidden">подряд</span>
        </div>
      </div>

      <div class="card q">
        <div class="q-meta">
          <span class="chip topic"></span>
          <span class="muted q-count"></span>
        </div>
        <h2 class="q-title"></h2>
        <p class="feedback" role="status"></p>
        <div class="q-formula"></div>
        <form class="answer" autocomplete="off">
          <label class="visually-hidden" for="blitz-input">Правая часть формулы</label>
          <input
            id="blitz-input"
            class="input"
            type="text"
            inputmode="text"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="go"
            placeholder="Например: mv^2/2"
          />
          <button type="submit" class="btn check">Ответить</button>
        </form>

        <!-- Phones show one key set at a time (the «αβγ» key switches), above the field so the
             on-screen keyboard doesn't cover it; wide screens show both below the field. -->
        <div class="palette" aria-label="Символы">
          <div class="row vars" aria-label="Величины"></div>
          <div class="keys ops">
            {symbols.map((c) => <button type="button" class="key" data-insert={c}>{c}</button>)}
            {functions.map((f) => <button type="button" class="key fn" data-insert={`${f}(`}>{f}</button>)}
            <button type="button" class="key toggle" aria-label="Греческие буквы">αβγ</button>
          </div>
          <div class="keys greek">
            {greek.map((c) => <button type="button" class="key" data-insert={c}>{c}</button>)}
            <button type="button" class="key toggle" aria-label="Знаки и функции">√ ²</button>
          </div>
        </div>

        <div class="q-actions">
          <button type="button" class="btn ghost small skip" title="Esc">Не помню</button>
          <button type="button" class="btn ghost small stop">Закончить</button>
        </div>
      </div>
    </section>

    <section class="b-end" hidden>
      <div class="card result">
        <div class="eyebrow over"></div>
        <div class="big"><span class="final">0</span><small>верных</small></div>
        <p class="summary muted"></p>
        <p class="new-record" hidden>Новый рекорд!</p>
        <div class="end-actions">
          <button type="button" class="btn again">Ещё раз</button>
          <button type="button" class="btn ghost retry" hidden>Повторить ошибки</button>
          <button type="button" class="btn ghost menu">Выбрать раздел</button>
        </div>
      </div>
      <div class="review" hidden>
        <h2>Повторите</h2>
        <ul class="missed"></ul>
      </div>
    </section>
  </formula-blitz>
</Base>

<script>
  import '../../lib/blitz/game';
</script>

<style>
  .setup {
    padding: 1.1rem 1.25rem 1.25rem;
    display: grid;
    gap: 1rem;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  legend {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.45rem;
  }
  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .opt span {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .opt small {
    color: var(--muted);
    font-weight: 500;
  }
  .opt input:checked + span {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--text);
  }
  .opt input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .go-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .go {
    font-size: 1.1rem;
    padding: 0.75rem 2.2rem;
  }
  .record {
    margin: 0;
    font-size: 0.9rem;
  }
  .howto {
    margin-top: 1rem;
    padding: 0.8rem 1.25rem;
    font-size: 0.925rem;
  }
  .howto summary {
    cursor: pointer;
    font-weight: 600;
  }
  .howto ul {
    margin: 0.6rem 0 0.2rem;
    padding-left: 1.2rem;
  }
  .howto li + li {
    margin-top: 0.35rem;
  }
  code {
    font-size: 0.9em;
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    background: var(--surface-2);
  }

  /* --- play --- */
  .b-play {
    max-width: 44rem;
    margin: 1.25rem auto 0;
  }
  .hud {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .stat {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 4.2rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }
  .stat.score .ico {
    color: var(--ok);
    font-weight: 800;
  }
  .stat.streak {
    justify-self: end;
  }
  .stat.streak[data-hot] {
    border-color: var(--warn);
    background: var(--warn-soft);
  }
  .stat .v.pop {
    animation: pop 0.35s ease-out;
  }
  .timer {
    position: relative;
    display: grid;
    gap: 0.25rem;
    justify-items: center;
  }
  .clock {
    font-size: 1.5rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .track {
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--accent), var(--ok));
    transform-origin: left;
    transition: transform 0.25s linear;
  }
  .timer[data-low] .clock {
    color: var(--bad);
    animation: pulse 1s ease-in-out infinite;
  }
  .timer[data-low] .fill {
    background: var(--bad);
  }
  .bonus {
    position: absolute;
    right: 0;
    top: -0.2rem;
    font-weight: 800;
    color: var(--ok);
    opacity: 0;
  }
  .bonus.show {
    animation: rise 1.1s ease-out;
  }

  .q {
    padding: 1rem 1.1rem 1.1rem;
  }
  .q.ok {
    animation: glow-ok 0.5s ease-out;
  }
  .q.bad {
    animation: shake 0.35s ease-in-out;
  }
  .q-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8rem;
  }
  .q-meta .topic {
    white-space: normal;
  }
  .q-count {
    white-space: nowrap;
  }
  .q-title {
    margin: 0.5rem 0 0.25rem;
    font-size: 1.1rem;
    line-height: 1.35;
  }
  .q-formula {
    min-height: 4.2rem;
    display: grid;
    place-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    font-size: 1.15rem;
  }
  .q-formula :global(.katex-display) {
    margin: 0.4rem 0;
  }
  .q-formula :global(.slot) {
    color: var(--muted);
  }
  .q-formula :global(.raw) {
    font-family: ui-monospace, monospace;
    color: var(--muted);
  }
  .answer {
    display: flex;
    gap: 0.5rem;
  }
  .input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 1.1rem; /* ≥16px: iOS would zoom in on focus */
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text);
  }
  .input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 0;
  }
  .feedback {
    min-height: 1.6em;
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
    text-align: center;
  }
  .feedback[data-kind='ok'] {
    color: var(--ok);
    font-weight: 700;
  }
  .feedback[data-kind='bad'] {
    color: var(--bad);
  }
  .feedback[data-kind='hint'] {
    color: var(--warn-text);
  }
  .palette {
    display: grid;
    gap: 0.4rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .row.vars:empty {
    display: none;
  }
  .keys {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(2.4rem, 1fr));
    gap: 0.3rem;
  }
  .keys .key {
    min-width: 0;
    padding: 0;
  }
  .toggle {
    display: none;
    color: var(--accent);
  }
  .key,
  .row.vars :global(button) {
    min-width: 2.4rem;
    height: 2.4rem;
    padding: 0 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    cursor: pointer;
    touch-action: manipulation;
  }
  .row.vars :global(button) {
    background: var(--accent-soft);
    border-color: transparent;
  }
  .key:hover,
  .row.vars :global(button:hover) {
    border-color: var(--accent);
  }
  .key.fn {
    font-size: 0.9rem;
  }
  .q-actions {
    display: flex;
    justify-content: space-between;
    margin-top: 0.85rem;
  }

  /* --- end --- */
  .b-end {
    max-width: 44rem;
    margin: 1.5rem auto 0;
  }
  .result {
    padding: 1.5rem 1.25rem;
    text-align: center;
  }
  .big {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0.4rem 0;
  }
  .final {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .big small {
    color: var(--muted);
    font-size: 1rem;
  }
  .summary {
    margin: 0.25rem 0;
  }
  .new-record {
    display: inline-block;
    margin: 0.5rem 0 0;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    background: var(--warn-soft);
    color: var(--warn-text);
    font-weight: 800;
    animation: pop 0.5s ease-out;
  }
  .end-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .review h2 {
    font-size: 1.1rem;
    margin: 1.5rem 0 0.5rem;
  }
  .missed {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .missed :global(li) {
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    overflow-x: auto;
  }
  .missed :global(.t) {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .missed :global(.yours) {
    font-size: 0.85rem;
    color: var(--bad);
  }

  @keyframes pop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.35);
    }
    100% {
      transform: scale(1);
    }
  }
  @keyframes pulse {
    50% {
      opacity: 0.55;
    }
  }
  @keyframes rise {
    0% {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(-1rem);
    }
  }
  @keyframes shake {
    20%,
    60% {
      transform: translateX(-6px);
    }
    40%,
    80% {
      transform: translateX(6px);
    }
  }
  @keyframes glow-ok {
    0% {
      box-shadow: 0 0 0 0 var(--ok);
    }
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .q.ok,
    .q.bad,
    .stat .v.pop,
    .timer[data-low] .clock,
    .bonus.show,
    .new-record {
      animation: none;
    }
    .bonus.show {
      opacity: 1;
    }
  }
  .answer {
    margin-top: 0.25rem;
  }
  .palette {
    margin-top: 0.75rem;
  }
  /* Phones: the palette goes above the field (the on-screen keyboard covers what is below
     it) and shows one key set at a time. */
  @media (max-width: 40rem) {
    .q {
      display: flex;
      flex-direction: column;
    }
    .palette {
      order: 1;
      margin: 0 0 0.6rem;
    }
    .answer {
      order: 2;
    }
    .q-actions {
      order: 3;
    }
    .toggle {
      display: block;
    }
    .palette:not([data-greek]) .greek,
    .palette[data-greek] .ops {
      display: none;
    }
  }
  @media (max-width: 30rem) {
    .stat {
      min-width: 0;
      font-size: 1rem;
    }
    .check {
      padding-inline: 0.75rem;
    }
  }
</style>
