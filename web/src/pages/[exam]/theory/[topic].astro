---
import type { GetStaticPaths } from 'astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TutorChat from '../../../components/TutorChat.astro';
import { bundle, taskUrl, theoryUrl, topicsById } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const pages = await getCollection('theory');
  return pages.map((entry) => {
    const [exam, topic] = entry.id.split('/');
    return { params: { exam, topic }, props: { entry } };
  });
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'theory'>;
}

const { entry } = Astro.props;
const { exam } = Astro.params;
const b = bundle(exam);
const topics = topicsById(b);
const topic = topics.get(entry.data.topic);
if (!topic) throw new Error(`Theory page ${entry.id} references unknown topic`);

const { Content } = await render(entry);
const prereqs = topic.prereqs.map((id) => topics.get(id)).filter((t) => t !== undefined);
const tasks = b.tasks
  .filter((t) => t.topics.includes(topic.id))
  .sort((x, y) => x.ege_task - y.ege_task || x.difficulty - y.difficulty);
---

<Base title={`${entry.data.title} — ${b.exam.title}`} narrow>
  <nav class="crumbs"><a href="/">← Роадмап</a></nav>
  <h1>
    {entry.data.title}
    {entry.data.status === 'draft' && <span class="badge draft">черновик</span>}
  </h1>

  <aside class="facts">
    {
      topic.ege_tasks.length > 0 && (
        <p>
          Задания ЕГЭ: <span class="badge">№ {topic.ege_tasks.join(', ')}</span>
        </p>
      )
    }
    {
      prereqs.length > 0 && (
        <p>
          Сначала изучите:{' '}
          {prereqs.map((p, i) => (
            <>
              {i > 0 && ', '}
              <a href={theoryUrl(exam, p.id)}>{p.title}</a>
            </>
          ))}
        </p>
      )
    }
  </aside>

  <article class="prose reading">
    <Content />
  </article>

  <TutorChat kind="theory" contextId={topic.id} />

  {
    tasks.length > 0 && (
      <section class="practice">
        <h2>Практика</h2>
        <ol>
          {tasks.map((t, i) => (
            <li>
              <a href={taskUrl(exam, t.id)}>
                Задача {i + 1} · задание № {t.ege_task}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<script>
  // Interactive models are written into theory Markdown as custom elements. Fetch a model's
  // code only on pages that use it, so most theory pages stay JavaScript-free.
  if (document.querySelector('pp-projectile')) void import('../../../lib/sims/projectile');
</script>

<style>
  .crumbs {
    margin-top: 1rem;
    font-size: 0.875rem;
  }
  h1 .badge {
    vertical-align: middle;
    margin-left: 0.5rem;
  }
  .crumbs a {
    text-decoration: none;
  }
  .facts {
    font-size: 0.925rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .facts p {
    margin: 0.4rem 0;
  }
  .prose :global(h2) {
    margin-top: 2rem;
  }
</style>
