# Local development. Copy to .env in the repo root (gitignored); the API and tutor-eval read it.
# Docker deployments use infra/.env instead (see infra/.env.example).

API_ENV=dev
API_DATABASE_URL=sqlite+aiosqlite:///dev.db

# Tutor model for development: OpenRouter free models (OpenAI-compatible endpoint).
# Key: https://openrouter.ai/settings/keys. Reachable from Russia without a proxy.
# Free tier: ~20 requests/min and ~50/day (1000/day after a one-time $10 top-up), so use
# evals/suite-theory-quick.yaml or --persona filters rather than the full suite.
# Dev only: free endpoints may log or train on prompts and are outside Russia, so never
# point a deployment with real students at them (152-FZ). Prompts here carry only content
# and your own test messages.
API_LLM_BASE_URL=https://openrouter.ai/api/v1
API_LLM_API_KEY=
# Checked 2026-11-03: Nemotron 3 Ultra answers in good Russian (TTFT ~5 s). Don't use
# openrouter/free (a random model per request: eval runs stop being comparable); Gemma 4
# was rate-limited upstream and emits <thought> blocks; Inkling is closed to API use.
# Pin a concrete id so eval runs stay comparable.
API_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Replaces the default extra body (vLLM/Qwen chat_template_kwargs). OpenRouter's reasoning
# switch: think briefly and keep the thinking out of the stream.
API_LLM_EXTRA_BODY={"reasoning": {"effort": "low", "exclude": true}}
# Only the model calls go through API_LLM_PROXY (http:// or socks5://, socksio is a dev
# dependency), for providers that refuse Russian addresses (e.g. Google AI Studio).
# API_LLM_PROXY=socks5://user:pass@host:port

# Optional fallback, e.g. DeepSeek (paid). Prices in kopecks per million tokens.
# API_LLM_FALLBACK_BASE_URL=https://api.deepseek.com
# API_LLM_FALLBACK_API_KEY=
# API_LLM_FALLBACK_MODEL=deepseek-chat
# API_LLM_FALLBACK_PRICE_IN=0
# API_LLM_FALLBACK_PRICE_OUT=0
