{
	# Set ACME_EMAIL in prod for Let's Encrypt notices.
	email {$ACME_EMAIL:}
}

# SITE_ADDRESS: a domain in prod (automatic HTTPS), ":80" locally.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		@hashed path /_astro/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
