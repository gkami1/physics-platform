---
import type { GetStaticPaths } from 'astro';
import TaskAnswer from '../../../components/TaskAnswer.astro';
import TutorChat from '../../../components/TutorChat.astro';
import Base from '../../../layouts/Base.astro';
import {
  bundles,
  difficultyLabel,
  embeddingPage,
  inSeason,
  type PublicBundle,
  type PublicTask,
  specFor,
  tasksUrl,
  theoryUrl,
  topicsById,
} from '../../../lib/content';
import { renderMarkdown } from '../../../lib/markdown';

export const getStaticPaths = (() =>
  bundles().flatMap((b) =>
    b.tasks.map((task) => ({ params: { exam: b.exam.id, id: task.id }, props: { b, task } })),
  )) satisfies GetStaticPaths;

interface Props {
  b: PublicBundle;
  task: PublicTask;
}

const { b, task } = Astro.props;
const spec = specFor(b, task);
const topics = topicsById(b);
const stepOf = embeddingPage(b, task.id);
// A task whose number no longer fits this season's plan keeps its old number, labelled.
const heading =
  task.ege_task === null
    ? spec.title
    : inSeason(b, task)
      ? `Задание № ${task.ege_task}`
      : `Задание № ${task.ege_task} (ЕГЭ ${task.last_season})`;
const theoryTopics = new Set(b.theory.map((t) => t.topic));
const statementHtml = await renderMarkdown(task.statement);
---

<Base title={`${heading} · ${task.id} — ${b.exam.title}`} narrow>
  <nav class="crumbs">
    {
      stepOf ? (
        <a href={theoryUrl(b.exam.id, stepOf.id)} class="back">
          ← {stepOf.number ? `${stepOf.number} ${stepOf.title}` : stepOf.title}
        </a>
      ) : (
        <a href={tasksUrl(b.exam.id)} class="back">
          ← Практика
        </a>
      )
    }
    <a href="#" class="btn ghost small more" hidden>Ещё задача 🎲</a>
  </nav>
  <h1>{heading}</h1>
  <p class="meta">
    <span class="badge">{spec.title}</span>
    <span class="muted"
      >макс. {spec.max_points} балл{spec.max_points === 1 ? '' : 'а'} · {difficultyLabel(task.difficulty)}</span
    >
  </p>

  <article class="card statement reading" set:html={statementHtml} />

  <TaskAnswer taskId={task.id} kind={task.answer_input.type} unit={task.answer_input.unit} />
  <TutorChat kind="task" contextId={task.id} />

  <aside class="topics muted">
    Темы:{' '}
    {
      task.topics.map((id, i) => {
        const t = topics.get(id);
        const title = t?.title ?? id;
        return (
          <>
            {i > 0 && ', '}
            {theoryTopics.has(id) ? <a href={theoryUrl(b.exam.id, id)}>{title}</a> : title}
          </>
        );
      })
    }
  </aside>
</Base>

<script>
  // Came here through «Случайная задача»: offer another one from the same filtered pool.
  try {
    const raw = sessionStorage.getItem('pp:practice-pool');
    const pool = raw ? (JSON.parse(raw) as { back: string; hrefs: string[] }) : null;
    if (pool?.hrefs.includes(location.pathname)) {
      const back = document.querySelector<HTMLAnchorElement>('.crumbs .back')!;
      back.href = pool.back;
      const others = pool.hrefs.filter((h) => h !== location.pathname);
      const more = document.querySelector<HTMLAnchorElement>('.crumbs .more')!;
      if (others.length > 0) {
        more.href = others[Math.floor(Math.random() * others.length)]!;
        more.hidden = false;
      }
    }
  } catch {
    // Storage off or malformed: plain page.
  }
</script>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
  }
  .back {
    text-decoration: none;
  }
  .statement {
    padding: 0.25rem 1.25rem;
    margin: 1rem 0 1.25rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
    margin-top: 0;
  }
  .topics {
    font-size: 0.875rem;
  }
</style>
