---
// A topic's tasks that are not already inside its theory as step tasks.
import { type PublicBundle, taskOrder, taskUrl, topicStepTasks } from '../../lib/content';

interface Props {
  b: PublicBundle;
  topicId: string;
}
const { b, topicId } = Astro.props;
const embedded = topicStepTasks(b, topicId);
const tasks = b.tasks
  .filter((t) => t.topics.includes(topicId) && !embedded.has(t.id))
  .sort((x, y) => taskOrder(x) - taskOrder(y) || x.difficulty - y.difficulty);
---

{
  tasks.length > 0 && (
    <topic-practice>
      <section class="practice" id="practice">
        <h2>Практика</h2>
        <ol>
          {tasks.map((t, i) => (
            <li>
              <a href={taskUrl(b.exam.id, t.id)}>
                Задача {i + 1}
                {t.ege_task === null ? ' · к теории' : ` · задание № ${t.ege_task}`}
              </a>
            </li>
          ))}
        </ol>
      </section>
    </topic-practice>
  )
}

<script>
  import { savePool } from '../../lib/taskPool';

  // Opening a task from this list: the task page's «Назад» returns here and its pager
  // walks this topic's tasks, not the whole EGE number.
  class TopicPractice extends HTMLElement {
    connectedCallback() {
      const links = [...this.querySelectorAll<HTMLAnchorElement>('ol a')];
      const hrefs = links.map((a) => a.pathname);
      this.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('ol a')) return;
        savePool({ back: `${location.pathname}#practice`, hrefs });
      });
    }
  }

  customElements.define('topic-practice', TopicPractice);
</script>
