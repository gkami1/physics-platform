---
import type { TaskNumberSpec } from '../lib/content';
import { answerControlsHtml } from '../lib/task-answer-markup.mjs';

interface Props {
  taskId: string;
  kind: TaskNumberSpec['answer_kind'];
  unit: string | null;
}

const { taskId, kind, unit } = Astro.props;
---

<task-answer
  data-task-id={taskId}
  data-kind={kind}
  set:html={answerControlsHtml({ taskId, kind, unit })}
/>

<script>
  import '../lib/task-answer';
</script>
