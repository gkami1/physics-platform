# Copy to infra/.env on the server. Never commit the real file.
SITE_ADDRESS=example.ru
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PASSWORD=change-me-to-a-long-random-string
API_ENV=prod
API_LOG_LEVEL=INFO
# Login codes are emailed via SMTP. Use a Russian provider (152-FZ), e.g. Yandex 360:
# a mailbox on your domain + an app password (id.yandex.ru -> Security -> App passwords).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@example.ru
SMTP_PASSWORD=app-password
MAIL_FROM="Физика ЕГЭ <noreply@example.ru>"
# Tutor models. Primary: self-hosted vLLM (Qwen3). Fallback: DeepSeek (prices: kopecks per
# million tokens). Never Google AI Studio's free tier here: it is for development only.
LLM_BASE_URL=http://gpu-host:8000/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-8B
LLM_FALLBACK_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=deepseek-chat
LLM_FALLBACK_PRICE_IN=0
LLM_FALLBACK_PRICE_OUT=0
# Tutor messages per 24 h: free and with a pass. Fair use: a pass whose model spend over 30 days
# reaches the budget (kopecks) gets the free cap until it falls under again; 0 turns it off.
TUTOR_DAILY_MESSAGES=20
TUTOR_PAID_DAILY_MESSAGES=100
TUTOR_PAID_MONTHLY_BUDGET_KOP=40000
# Robokassa (docs/DEPLOY.md, «Robokassa»). Technical settings of the shop -> login and
# passwords #1/#2. While ROBOKASSA_TEST=true use the TEST passwords; switch to the live ones
# together with ROBOKASSA_TEST=false. ROBOKASSA_HASH must match the shop's hash algorithm.
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST=true
ROBOKASSA_HASH=md5
PRICE_MONTH_KOP=79000
PRICE_SEASON_KOP=299000
# Seller shown in the footer and the legal pages (a самозанятый must show name and ИНН).
# Optional overrides of the public seller details in web/src/lib/seller.ts.
# Rebuild the web image after changing seller details or prices.
# SELLER_NAME=
# SELLER_INN=
# CONTACT_EMAIL=
