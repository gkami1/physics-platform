# Local development. Copy to .env in the repo root (gitignored); the API and tutor-eval read it.
# Docker deployments use infra/.env instead (see infra/.env.example).

API_ENV=dev
API_DATABASE_URL=sqlite+aiosqlite:///dev.db

# Tutor model for development: Google AI Studio free tier (OpenAI-compatible endpoint).
# Key: https://aistudio.google.com/apikey
# Google refuses requests from Russia (HTTP 400 "User location is not supported"): it needs
# a VPN or HTTPS_PROXY (httpx honours it) in the shell that runs the API / tutor-eval.
# Dev only: the free tier may use prompts to improve Google's models and is outside Russia,
# so never point a deployment with real students at it (152-FZ). Prompts here carry only
# content and your own test messages.
API_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
API_LLM_API_KEY=
# Checked 2026-10-28: full Flash models were overloaded (503) on the free tier and
# 2.5 Flash is closed to new keys; 3.1 Flash-Lite with thinking off answered in ~4 s.
# Pin a concrete id (not a *-latest alias) so eval runs stay comparable.
API_LLM_MODEL=gemini-3.1-flash-lite
# Gemini rejects vLLM's chat_template_kwargs. "none" turns thinking off where the model
# allows it (3.x Flash-Lite does; some models reject it with HTTP 400 — then use {}).
API_LLM_EXTRA_BODY={"reasoning_effort": "none"}

# Optional fallback, e.g. DeepSeek (paid). Prices in kopecks per million tokens.
# API_LLM_FALLBACK_BASE_URL=https://api.deepseek.com
# API_LLM_FALLBACK_API_KEY=
# API_LLM_FALLBACK_MODEL=deepseek-chat
# API_LLM_FALLBACK_PRICE_IN=0
# API_LLM_FALLBACK_PRICE_OUT=0
