---
// One lesson of a topic split into lessons: the text, the tutor beside it (its own thread),
// the topic's lesson strip at the top and the next lesson at the bottom.
import type { GetStaticPaths } from 'astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import TheoryWithChat from '../../../../components/theory/TheoryWithChat.astro';
import { bundle, lessonsOf, theoryPage, theoryUrl } from '../../../../lib/content';

export const getStaticPaths = (async () => {
  const pages = await getCollection('theory');
  return pages
    .filter((entry) => entry.id.split('/').length === 3)
    .map((entry) => {
      const [exam, topic, lesson] = entry.id.split('/');
      return { params: { exam, topic, lesson }, props: { entry } };
    });
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'theory'>;
}

const { entry } = Astro.props;
const { exam, topic, lesson } = Astro.params;
const b = bundle(exam);
const id = `${topic}/${lesson}`;
const page = theoryPage(b, id);
const intro = theoryPage(b, topic);
if (!page || !intro) throw new Error(`Lesson ${entry.id} is not in build/public: run npm run content`);
const lessons = lessonsOf(b, topic);
const i = lessons.findIndex((l) => l.id === id);
const prev = lessons[i - 1];
const next = lessons[i + 1];
const { Content } = await render(entry);
---

<Base title={`${page.number} ${entry.data.title} — ${intro.title}`}>
  <TheoryWithChat contextId={id}>
    <nav class="crumbs">
      <a href={theoryUrl(exam, topic)}>← {intro.title}</a>
    </nav>

    <ol class="strip" aria-label={`Уроки темы «${intro.title}»`}>
      {
        lessons.map((l) => (
          <li>
            <a
              href={theoryUrl(exam, l.id)}
              title={l.title}
              aria-current={l.id === id ? 'page' : undefined}
            >
              {l.number}
            </a>
          </li>
        ))
      }
    </ol>

    <p class="eyebrow">
      Урок {page.number} <span class="grade-badge">{page.grade} класс</span>
      {entry.data.status === 'draft' && <span class="badge draft">черновик</span>}
    </p>
    <h1>{entry.data.title}</h1>

    <article class="prose reading">
      <Content />
    </article>

    <nav class="pager" aria-label="Соседние уроки">
      {
        prev ? (
          <a class="prev" href={theoryUrl(exam, prev.id)}>
            <span class="dir">← Предыдущий</span>
            <span>
              {prev.number} {prev.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="next" href={theoryUrl(exam, next.id)}>
            <span class="dir">Следующий урок →</span>
            <span>
              {next.number} {next.title}
            </span>
          </a>
        ) : (
          <a class="next" href={theoryUrl(exam, topic)}>
            <span class="dir">Тема пройдена →</span>
            <span>К задачам темы</span>
          </a>
        )
      }
    </nav>
  </TheoryWithChat>
</Base>

<style>
  .crumbs {
    margin-top: 1rem;
    font-size: 0.875rem;
  }
  .crumbs a {
    text-decoration: none;
  }
  .strip {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    margin: 0.75rem 0 0;
  }
  .strip a {
    display: inline-block;
    min-width: 2.75rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    text-decoration: none;
  }
  .strip a:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .strip a[aria-current='page'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .eyebrow {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .eyebrow .badge {
    margin-left: 0.4rem;
  }
  h1 {
    margin-top: 0.25rem;
  }
  .prose :global(h2) {
    margin-top: 2rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin: 2.5rem 0 1.5rem;
  }
  .pager a {
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    font-size: 0.925rem;
    min-width: 0;
  }
  .pager a:hover {
    border-color: var(--accent);
  }
  .pager .next {
    text-align: right;
    grid-column: 2;
  }
  .pager .dir {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 600;
  }
  @media (max-width: 30rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      grid-column: 1;
    }
    .pager > span {
      display: none;
    }
  }
</style>
