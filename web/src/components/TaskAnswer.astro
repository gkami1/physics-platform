---
import type { TaskNumberSpec } from '../lib/content';

interface Props {
  taskId: string;
  kind: TaskNumberSpec['answer_kind'];
  unit: string | null;
}

const { taskId, kind, unit } = Astro.props;

const placeholder: Record<string, string> = {
  numeric: 'Например, 12,5',
  sequence: 'Например, 13',
  measurement: 'Значение и погрешность: 2,4 0,2',
};
const inputMode = kind === 'sequence' ? 'numeric' : kind === 'numeric' ? 'decimal' : 'text';
---

<task-answer data-task-id={taskId} data-kind={kind}>
  {
    kind === 'extended' ? (
      <p class="hint">
        Решите задачу на бумаге с полным обоснованием, затем сравните с эталонным решением.
      </p>
    ) : (
      <form class="answer" novalidate>
        <label for="answer-input">Ответ</label>
        <div class="row">
          <input
            id="answer-input"
            name="answer"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            inputmode={inputMode}
            maxlength="64"
            placeholder={placeholder[kind]}
            required
          />
          {unit && <span class="unit">{unit}</span>}
          <button type="submit">Проверить</button>
        </div>
      </form>
    )
  }
  <p class="verdict" role="status" aria-live="polite" hidden></p>
  <p class="history muted" hidden></p>
  <button type="button" class="reveal" hidden={kind !== 'extended'}>
    Показать решение
  </button>
  <section class="solution" hidden>
    <h2>Решение</h2>
    <p class="final"></p>
    <div class="solution-body"></div>
  </section>
</task-answer>

<script>
  import { ApiError, api, type AttemptResponse, type TaskState } from '../lib/api';

  const MESSAGES: Record<string, (r: AttemptResponse) => string> = {
    correct: (r) => `Верно! ${r.points} из ${r.max_points}`,
    partial: (r) => `Почти: ${r.points} из ${r.max_points} — одна ошибка`,
    wrong: () => 'Неверно. Попробуйте ещё раз',
    invalid: () => 'Не получилось распознать ответ — проверьте формат',
  };

  class TaskAnswer extends HTMLElement {
    private taskId = '';

    connectedCallback() {
      this.taskId = this.dataset.taskId ?? '';
      this.querySelector('form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        void this.submit();
      });
      this.q('.reveal').addEventListener('click', () => void this.reveal());
      void this.restore();
    }

    private q<T extends HTMLElement = HTMLElement>(sel: string): T {
      return this.querySelector(sel) as T;
    }

    private async restore() {
      try {
        this.showState(await api.state(this.taskId));
      } catch {
        // Offline or API down: the form still works once it comes back.
      }
    }

    private showState(s: TaskState) {
      const graded = s.attempts.filter((a) => a.outcome !== 'revealed');
      if (graded.length > 0) {
        const h = this.q('.history');
        h.textContent = `Попыток: ${graded.length} · лучший результат: ${s.best_points} из ${s.max_points}`;
        h.hidden = false;
      }
      this.q('.reveal').hidden = !s.solution_available;
    }

    private async submit() {
      const input = this.q<HTMLInputElement>('input');
      const button = this.q<HTMLButtonElement>('form button');
      const answer = input.value.trim();
      if (!answer) return input.focus();
      button.disabled = true;
      try {
        const r = await api.submit(this.taskId, answer);
        this.verdict(MESSAGES[r.outcome]?.(r) ?? '', r.outcome);
        this.q('.reveal').hidden = !r.solution_available;
        if (r.outcome !== 'invalid') void this.restore();
      } catch (e) {
        this.verdict(this.errorText(e), 'error');
      } finally {
        button.disabled = false;
      }
    }

    private async reveal() {
      const button = this.q<HTMLButtonElement>('.reveal');
      button.disabled = true;
      try {
        const [s, { renderMarkdown }] = await Promise.all([
          api.reveal(this.taskId),
          import('../lib/client-markdown'),
        ]);
        const final = this.q('.final');
        final.textContent = s.answer ? `Ответ: ${s.answer}` : '';
        this.q('.solution-body').innerHTML = renderMarkdown(s.solution);
        this.q('.solution').hidden = false;
        button.hidden = true;
      } catch (e) {
        this.verdict(this.errorText(e), 'error');
      } finally {
        button.disabled = false;
      }
    }

    private verdict(text: string, kind: string) {
      const v = this.q('.verdict');
      v.textContent = text;
      v.dataset.kind = kind;
      v.hidden = !text;
    }

    private errorText(e: unknown): string {
      if (e instanceof ApiError && e.status === 403) return 'Сначала попробуйте решить задачу';
      return 'Нет связи с сервером. Попробуйте ещё раз';
    }
  }

  customElements.define('task-answer', TaskAnswer);
</script>

<style>
  task-answer {
    display: block;
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 1.1rem; /* ≥16px stops iOS zooming on focus */
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
  }
  .unit {
    color: var(--muted);
    white-space: nowrap;
  }
  button {
    font: inherit;
    font-weight: 600;
    padding: 0.55rem 1rem;
    border: 0;
    border-radius: 8px;
    background: var(--accent);
    color: var(--surface);
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
  }
  .reveal {
    margin-top: 0.5rem;
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .verdict {
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
  }
  .verdict[data-kind='correct'] {
    color: var(--ok);
  }
  .verdict[data-kind='partial'] {
    color: var(--warn-text);
  }
  .verdict[data-kind='wrong'],
  .verdict[data-kind='error'] {
    color: var(--bad);
  }
  .history {
    font-size: 0.875rem;
    margin: 0.25rem 0;
  }
  .hint {
    margin: 0;
  }
  .solution {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .final {
    font-weight: 600;
  }
</style>
