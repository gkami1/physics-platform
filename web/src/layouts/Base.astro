---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Подготовка к ЕГЭ по физике: теория, задачи и ИИ-репетитор' } =
  Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">Физика ЕГЭ</a>
        <nav class="nav">
          <a href="/">Роадмап</a>
          <a href="/ege-physics/tasks/">Задачи</a>
          <site-account>
            <a href="/login/" class="login">Войти</a>
            <span class="who" hidden><span class="email"></span><button type="button">Выйти</button></span>
          </site-account>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>

<script>
  import { api } from '../lib/api';

  // Static pages can't know who is signed in; ask the API once per page load.
  class SiteAccount extends HTMLElement {
    connectedCallback() {
      const login = this.querySelector('.login') as HTMLAnchorElement;
      if (!location.pathname.startsWith('/login')) {
        login.href = `/login/?next=${encodeURIComponent(location.pathname)}`;
      }
      this.querySelector('button')?.addEventListener('click', () => {
        void api.logout().finally(() => location.reload());
      });
      void api.me().then(
        ({ user }) => {
          if (!user) return;
          const email = this.querySelector('.email') as HTMLElement;
          email.textContent = user.email;
          email.title = user.email;
          login.hidden = true;
          (this.querySelector('.who') as HTMLElement).hidden = false;
        },
        () => {}, // API down: keep the «Войти» link.
      );
    }
  }

  customElements.define('site-account', SiteAccount);
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .site-header .wrap {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
  }
  .brand {
    font-weight: 650;
    text-decoration: none;
    color: var(--text);
  }
  .nav {
    margin-left: auto;
    display: flex;
    gap: 1rem;
    font-size: 0.925rem;
  }
  .nav a {
    text-decoration: none;
  }
  .nav,
  site-account,
  .who {
    align-items: center;
  }
  site-account,
  .who:not([hidden]) {
    display: inline-flex;
    gap: 0.5rem;
  }
  .email {
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
  }
  /* Phones: brand + three nav items already fill the row. */
  @media (max-width: 30rem) {
    .email {
      display: none;
    }
  }
  .who button {
    font: inherit;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    cursor: pointer;
  }
  main {
    padding-bottom: 3rem;
  }
</style>
