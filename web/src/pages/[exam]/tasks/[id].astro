---
import type { GetStaticPaths } from 'astro';
import TaskAnswer from '../../../components/TaskAnswer.astro';
import TutorChat from '../../../components/TutorChat.astro';
import Base from '../../../layouts/Base.astro';
import {
  bundles,
  difficultyLabel,
  embeddingPage,
  inSeason,
  type PublicBundle,
  type PublicTask,
  specFor,
  taskUrl,
  tasksOfNumber,
  tasksUrl,
  theoryUrl,
  topicsById,
} from '../../../lib/content';
import { renderMarkdown } from '../../../lib/markdown';

export const getStaticPaths = (() =>
  bundles().flatMap((b) =>
    b.tasks.map((task) => ({ params: { exam: b.exam.id, id: task.id }, props: { b, task } })),
  )) satisfies GetStaticPaths;

interface Props {
  b: PublicBundle;
  task: PublicTask;
}

const { b, task } = Astro.props;
const spec = specFor(b, task);
const topics = topicsById(b);
const stepOf = embeddingPage(b, task.id);
// A task whose number no longer fits this season's plan keeps its old number, labelled.
const heading =
  task.ege_task === null
    ? spec.title
    : inSeason(b, task)
      ? `Задание № ${task.ege_task}`
      : `Задание № ${task.ege_task} (ЕГЭ ${task.last_season})`;
const theoryTopics = new Set(b.theory.map((t) => t.topic));
const statementHtml = await renderMarkdown(task.statement);
// Default pager without a saved list: the neighbours within this EGE number, catalog order.
const siblings =
  task.ege_task !== null && inSeason(b, task) ? tasksOfNumber(b, task.ege_task) : [];
const pos = siblings.findIndex((t) => t.id === task.id);
const prevTask = pos > 0 ? siblings[pos - 1] : undefined;
const nextTask = pos >= 0 ? siblings[pos + 1] : undefined;
---

<Base title={`${heading} · ${task.id} — ${b.exam.title}`} narrow>
  <nav class="crumbs">
    {
      stepOf ? (
        <a href={theoryUrl(b.exam.id, stepOf.id)} class="back">
          ← {stepOf.number ? `${stepOf.number} ${stepOf.title}` : stepOf.title}
        </a>
      ) : (
        <a href={tasksUrl(b.exam.id)} class="back">
          ← Практика
        </a>
      )
    }
    <a href="#" class="btn ghost small more" hidden>Ещё задача 🎲</a>
  </nav>
  <h1>{heading}</h1>
  <p class="meta">
    <span class="badge"
      >{inSeason(b, task) || task.ege_task === null ? spec.title : `не входит в ЕГЭ ${b.exam.season}`}</span
    >
    <span class="muted"
      >макс. {spec.max_points} балл{spec.max_points === 1 ? '' : 'а'} · {difficultyLabel(task.difficulty)}</span
    >
  </p>

  <article class="card statement reading" set:html={statementHtml} />

  <TaskAnswer taskId={task.id} kind={task.answer_input.type} unit={task.answer_input.unit} />

  <nav class="pager" aria-label="Соседние задачи" hidden={!prevTask && !nextTask}>
    <a class="btn ghost small prev" href={prevTask && taskUrl(b.exam.id, prevTask.id)} hidden={!prevTask}>
      ← Предыдущая
    </a>
    <span class="pos muted">{pos >= 0 && `${pos + 1} из ${siblings.length}`}</span>
    <a class="btn small next" href={nextTask && taskUrl(b.exam.id, nextTask.id)} hidden={!nextTask}>
      Следующая →
    </a>
  </nav>

  <TutorChat kind="task" contextId={task.id} />

  <aside class="topics muted">
    Темы:{' '}
    {
      task.topics.map((id, i) => {
        const t = topics.get(id);
        const title = t?.title ?? id;
        return (
          <>
            {i > 0 && ', '}
            {theoryTopics.has(id) ? <a href={theoryUrl(b.exam.id, id)}>{title}</a> : title}
          </>
        );
      })
    }
  </aside>
</Base>

<script>
  import { normalizePath, poolFor } from '../../../lib/taskPool';

  // Opened from a list (practice table, catalog number, «Случайная задача»): back returns
  // to it with its filters, and the pager and «Ещё задача» walk that list instead.
  const here = normalizePath(location.pathname);
  const pool = poolFor(here);
  if (pool) {
    const back = document.querySelector<HTMLAnchorElement>('.crumbs .back')!;
    back.href = pool.back;
    if (pool.backLabel) back.textContent = `← ${pool.backLabel}`;

    const i = pool.hrefs.indexOf(here);
    const link = (sel: string, href: string | undefined) => {
      const a = document.querySelector<HTMLAnchorElement>(sel)!;
      if (href) a.href = href;
      a.hidden = !href;
    };
    link('.pager .prev', pool.hrefs[i - 1]);
    link('.pager .next', pool.hrefs[i + 1]);
    document.querySelector('.pager .pos')!.textContent = `${i + 1} из ${pool.hrefs.length}`;
    document.querySelector<HTMLElement>('.pager')!.hidden = pool.hrefs.length < 2;

    const others = pool.hrefs.filter((h) => h !== here);
    link('.crumbs .more', others[Math.floor(Math.random() * others.length)]);
  }
</script>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
  }
  .back {
    text-decoration: none;
  }
  .statement {
    padding: 0.25rem 1.25rem;
    margin: 1rem 0 1.25rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
    margin-top: 0;
  }
  .topics {
    font-size: 0.875rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem 0;
  }
  .pager .prev {
    grid-column: 1;
    justify-self: start;
  }
  .pager .pos {
    grid-column: 2;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .pager .next {
    grid-column: 3;
    justify-self: end;
  }
  /* 320px phones: both buttons plus the counter don't fit one row. */
  @media (max-width: 22rem) {
    .pager .pos {
      display: none;
    }
  }
</style>
