---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Reading pages (theory, task) use a narrow column; app pages the full width. */
  narrow?: boolean;
}

const {
  title,
  description = 'Подготовка к ЕГЭ по физике: теория, задачи, варианты и ИИ-репетитор',
  narrow = false,
} = Astro.props;

const exam = 'ege-physics';
const path = Astro.url.pathname;
const tabs = [
  { href: '/', label: 'Траектория', active: path === '/' || path.includes('/theory/') },
  { href: `/${exam}/catalog/`, label: 'Каталог', active: path.includes('/catalog') },
  {
    href: `/${exam}/practice/`,
    label: 'Практика',
    active: path.includes('/practice') || path.includes('/tasks/'),
  },
  { href: `/${exam}/variants/`, label: 'Варианты', active: path.includes('/variants') },
  { href: `/${exam}/blitz/`, label: 'Блиц', active: path.includes('/blitz') },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0f14" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <script is:inline>
      // Before first paint, so the light theme never flashes dark.
      try {
        if (localStorage.getItem('pp:theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="Физика ЕГЭ — на главную">
          <span class="logo" aria-hidden="true">Φ</span>
          <span class="name">Физика ЕГЭ</span>
        </a>
        <nav class="tabs" aria-label="Разделы">
          {
            tabs.map((t) => (
              <a href={t.href} aria-current={t.active ? 'page' : undefined}>
                {t.label}
              </a>
            ))
          }
        </nav>
        <div class="tools">
          <button type="button" class="theme" aria-label="Сменить тему" title="Сменить тему">
            <span aria-hidden="true">◐</span>
          </button>
          <site-account>
            <a href="/login/" class="btn small login">Войти</a>
            <span class="who" hidden>
              <span class="avatar" aria-hidden="true"></span>
              <span class="email"></span>
              <button type="button" class="logout">Выйти</button>
            </span>
          </site-account>
        </div>
      </div>
    </header>
    <main class:list={['wrap', { narrow }]}>
      <slot />
    </main>
    <footer class="wrap site-footer muted">
      <span>Физика ЕГЭ · задания по структуре ФИПИ</span>
    </footer>
  </body>
</html>

<script>
  import { api, session } from '../lib/api';

  document.querySelector('.theme')?.addEventListener('click', () => {
    const root = document.documentElement;
    const light = root.dataset.theme !== 'light';
    if (light) root.dataset.theme = 'light';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('pp:theme', light ? 'light' : 'dark');
    } catch {
      // Private mode: the choice lasts for this page only.
    }
  });

  // Static pages can't know who is signed in; ask the API once per page load.
  class SiteAccount extends HTMLElement {
    connectedCallback() {
      const login = this.querySelector('.login') as HTMLAnchorElement;
      if (!location.pathname.startsWith('/login')) {
        login.href = `/login/?next=${encodeURIComponent(location.pathname)}`;
      }
      this.querySelector('.logout')?.addEventListener('click', () => {
        void api.logout().finally(() => location.reload());
      });
      void session().then(
        ({ user }) => {
          if (!user) return;
          const email = this.querySelector('.email') as HTMLElement;
          email.textContent = user.email;
          email.title = user.email;
          (this.querySelector('.avatar') as HTMLElement).textContent =
            user.email.charAt(0).toUpperCase();
          login.hidden = true;
          (this.querySelector('.who') as HTMLElement).hidden = false;
        },
        () => {}, // API down: keep the «Войти» link.
      );
    }
  }

  customElements.define('site-account', SiteAccount);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--accent), var(--ok));
    color: var(--on-accent);
    font-size: 1.1rem;
    font-weight: 800;
  }
  .tabs {
    display: flex;
    gap: 0.25rem;
    justify-content: center;
  }
  .tabs a {
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-weight: 600;
    font-size: 0.925rem;
    text-decoration: none;
  }
  .tabs a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .tabs a[aria-current='page'] {
    color: var(--text);
    background: var(--accent-soft);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .tools,
  site-account,
  .who:not([hidden]) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .theme,
  .logout {
    font: inherit;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .theme {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    font-size: 1.1rem;
  }
  .theme:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .logout {
    font-size: 0.85rem;
    padding: 0;
  }
  .logout:hover {
    color: var(--accent);
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .email {
    max-width: 10rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
    font-size: 0.875rem;
  }
  main {
    padding-bottom: 3rem;
    min-height: calc(100vh - 8rem);
  }
  .site-footer {
    padding: 1.5rem var(--gutter) 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  /* Phones: tabs move to their own row under the brand. */
  @media (max-width: 44rem) {
    .bar {
      grid-template-columns: 1fr auto;
      padding-top: 0.4rem;
    }
    .tabs {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: stretch;
      padding-bottom: 0.4rem;
      /* Five tabs barely fit a 360px phone; scroll the row rather than the page. */
      overflow-x: auto;
      scrollbar-width: none;
    }
    .tabs a {
      flex: 1 0 auto;
      text-align: center;
      padding-inline: 0.3rem;
      white-space: nowrap;
    }
    .email {
      display: none;
    }
  }
  @media (max-width: 26rem) {
    .tabs {
      gap: 0;
    }
    .tabs a {
      font-size: 0.82rem;
      padding-inline: 0.25rem;
    }
  }
  @media (max-width: 22rem) {
    .name {
      display: none;
    }
  }
</style>
