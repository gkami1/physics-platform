---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { bundles, firstParagraph, type PublicBundle, taskUrl } from '../../../lib/content';
import { renderMarkdown } from '../../../lib/markdown';

export const getStaticPaths = (() =>
  bundles().map((b) => ({ params: { exam: b.exam.id }, props: { b } }))) satisfies GetStaticPaths;

interface Props {
  b: PublicBundle;
}

const { b } = Astro.props;
const previews = new Map(
  await Promise.all(
    b.tasks.map(async (t) => [t.id, await renderMarkdown(firstParagraph(t.statement))] as const),
  ),
);
const numbers = Object.keys(b.exam.tasks)
  .map(Number)
  .sort((x, y) => x - y)
  .map((n) => ({
    n,
    spec: b.exam.tasks[String(n)]!,
    tasks: b.tasks.filter((t) => t.ege_task === n).sort((x, y) => x.difficulty - y.difficulty),
  }))
  .filter((g) => g.tasks.length > 0);
---

<Base title={`Задачи — ${b.exam.title}`}>
  <h1>Задачи</h1>
  {
    numbers.map(({ n, spec, tasks }) => (
      <section>
        <h2>
          № {n} <span class="muted">· {spec.title}</span>
        </h2>
        <ul class="list">
          {tasks.map((t) => (
            <li>
              <a href={taskUrl(b.exam.id, t.id)} set:html={previews.get(t.id)} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  h2 {
    font-size: 1.1rem;
  }
  h2 .muted {
    font-weight: 400;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .list li {
    padding: 0.7rem 1rem;
  }
  .list li + li {
    border-top: 1px solid var(--border);
  }
  .list a {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
  }
  .list a :global(p) {
    display: inline;
    margin: 0;
  }
</style>
