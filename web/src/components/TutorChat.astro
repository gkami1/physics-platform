---
import type { TutorKind } from '../lib/api';

interface Props {
  kind: TutorKind;
  contextId: string;
  /**
   * `inline` (task pages): a button under the content opens the panel.
   * `docked` (theory pages): a sticky column beside the text on wide screens, a bottom
   * sheet behind a floating button on narrow ones.
   */
  variant?: 'inline' | 'docked';
}

const { kind, contextId, variant = 'inline' } = Astro.props;
const docked = variant === 'docked';
---

<tutor-chat data-kind={kind} data-id={contextId} data-variant={variant}>
  {
    docked ? (
      <button type="button" class="fab" aria-expanded="false" aria-controls="tutor-panel">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4A1.5 1.5 0 0 1 4 14.5z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
        </svg>
        Спросить
      </button>
    ) : (
      <button type="button" class="open">
        {kind === 'task' ? 'Спросить репетитора о задаче' : 'Задать вопрос по теме'}
      </button>
    )
  }
  <section
    class="panel"
    id={docked ? 'tutor-panel' : undefined}
    hidden={!docked}
    aria-label="ИИ-репетитор"
  >
    <header>
      <h2>Репетитор</h2>
      <span class="level muted" hidden></span>
      {
        docked && (
          <button
            type="button"
            class="widen"
            aria-pressed="false"
            aria-label="Развернуть чат"
            title="Развернуть чат"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                class="out"
                d="M10 4H4v6M4 4l6 6M14 20h6v-6M20 20l-6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                class="in"
                d="M4 10h6V4M10 10 4 4M20 14h-6v6M14 14l6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        )
      }
      {
        docked && (
          <button type="button" class="close" aria-label="Закрыть">
            ✕
          </button>
        )
      }
    </header>
    {docked && <p class="motto">Глупые вопросы рождают глубокое понимание.</p>}
    <p class="intro muted">
      {
        kind === 'task'
          ? 'Репетитор не скажет ответ сразу — он поможет дойти до него самому.'
          : docked
            ? 'Спрашивайте прямо по ходу чтения: репетитор видит эту страницу.'
            : 'Спросите, что непонятно на этой странице.'
      }
    </p>
    <ol class="log" aria-live="polite"></ol>
    <p class="notice" hidden></p>
    {
      docked && (
        <p class="signin" hidden>
          <a class="btn" href="/login/">
            Войти, чтобы спросить
          </a>
        </p>
      )
    }
    <form class="compose" novalidate>
      <div class="box">
        <textarea
          name="text"
          rows="2"
          maxlength="2000"
          placeholder={docked ? 'Что здесь непонятно?' : 'Ваш вопрос'}
          aria-label="Ваш вопрос"></textarea>
        <button type="submit" class="send" aria-label="Отправить" title="Отправить" disabled>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M12 19V5M6 11l6-6 6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
      <div class="actions">
        {kind === 'task' && <button type="button" class="hint secondary">Подсказка</button>}
        <span class="left muted"></span>
      </div>
    </form>
  </section>
  {docked && <div class="backdrop" hidden></div>}
</tutor-chat>

<script>
  import { ApiError, session, tutor, type TutorKind } from '../lib/api';

  type Render = typeof import('../lib/client-markdown');

  const ERRORS: Record<string, string> = {
    daily_limit: 'На сегодня сообщения закончились. Возвращайтесь завтра.',
    tutor_unavailable: 'Репетитор сейчас недоступен. Попробуйте чуть позже.',
  };

  /** Same breakpoint as the theory page grid: from here the chat is a column, not a sheet. */
  const WIDE = '(min-width: 64rem)';

  class TutorChat extends HTMLElement {
    private kind: TutorKind = 'task';
    private contextId = '';
    private docked = false;
    private md?: Render;
    private loading?: Promise<boolean>;
    private busy = false;
    private maxLevel = 3;

    connectedCallback() {
      this.kind = (this.dataset.kind as TutorKind) ?? 'task';
      this.contextId = this.dataset.id ?? '';
      this.docked = this.dataset.variant === 'docked';
      this.querySelector('.open')?.addEventListener('click', () => {
        this.q('.open').hidden = true;
        this.q('.panel').hidden = false;
        void this.ensureLoaded().then((ok) => ok && this.input.focus());
      });
      this.q<HTMLFormElement>('.compose').addEventListener('submit', (e) => {
        e.preventDefault();
        void this.send('message');
      });
      this.querySelector('.hint')?.addEventListener('click', () => void this.send('hint'));
      this.input.addEventListener('keydown', this.onKey);
      this.input.addEventListener('input', this.syncInput);
      // Refit when the box changes width (the docked panel widens as typing starts), so
      // a question measured in the narrow column doesn't leave empty lines below it.
      let width = 0;
      new ResizeObserver(([entry]) => {
        const w = entry?.contentRect.width ?? 0;
        if (w === width) return;
        width = w;
        this.syncInput();
      }).observe(this.input);
      if (this.docked) this.setUpDocked();
    }

    private q<T extends HTMLElement = HTMLElement>(sel: string): T {
      return this.querySelector(sel) as T;
    }

    private get input(): HTMLTextAreaElement {
      return this.q<HTMLTextAreaElement>('textarea');
    }

    private get storageKey(): string {
      return `pp:tutor:${this.kind}:${this.contextId}`;
    }

    // --- docked variant (theory pages) -------------------------------------------------

    private setUpDocked() {
      // The thread costs a request: fetch it on the first focus, not on every page view.
      this.input.addEventListener('focus', () => void this.ensureLoaded(), { once: true });
      this.q('.fab').addEventListener('click', () => this.setSheet(true));
      this.q('.close').addEventListener('click', () => this.setSheet(false));
      this.q('.backdrop').addEventListener('click', () => this.setSheet(false));
      this.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (this.hasAttribute('data-open')) this.setSheet(false);
        else if (this.hasAttribute('data-expanded')) this.setExpanded(false);
      });
      matchMedia(WIDE).addEventListener('change', (e) => {
        if (e.matches) this.setSheet(false);
        else this.setExpanded(false);
      });
      this.setUpExpand();
      // The header already asks who is signed in; reuse its answer. A student who has
      // talked on this page before sees the thread straight away (wide screens only: on
      // narrow ones it loads when the sheet opens).
      session().then(
        ({ user }) => {
          if (!user) this.showSignIn();
          else if (this.hadThread() && matchMedia(WIDE).matches) void this.ensureLoaded();
        },
        () => {}, // API down: sending will say so.
      );
    }

    /** Bottom sheet on narrow screens. */
    private setSheet(open: boolean) {
      const fab = this.q('.fab');
      const wasOpen = this.hasAttribute('data-open');
      this.toggleAttribute('data-open', open);
      fab.setAttribute('aria-expanded', String(open));
      this.q('.backdrop').hidden = !open;
      document.documentElement.classList.toggle('sheet-open', open);
      const vv = window.visualViewport;
      if (open) {
        vv?.addEventListener('resize', this.fitViewport);
        vv?.addEventListener('scroll', this.fitViewport);
        this.fitViewport();
        void this.ensureLoaded().then((ok) => {
          if (ok) this.input.focus();
          this.scrollLog();
        });
      } else {
        vv?.removeEventListener('resize', this.fitViewport);
        vv?.removeEventListener('scroll', this.fitViewport);
        if (wasOpen && !matchMedia(WIDE).matches) fab.focus();
      }
    }

    /**
     * Wide screens: the column widens over the text while the student works in the chat
     * (click, focus or typing in it, or the header button) and narrows again on a click
     * anywhere else, Esc or the button. A drag that selects text doesn't count as a click.
     */
    private setUpExpand() {
      const widen = this.q('.widen');
      const panel = this.q('.panel');
      const engage = (e: Event) => {
        if (!widen.contains(e.target as Node)) this.setExpanded(true);
      };
      panel.addEventListener('pointerdown', engage);
      panel.addEventListener('focusin', engage);
      this.input.addEventListener('input', () => this.setExpanded(true));
      widen.addEventListener('click', () => {
        const open = !this.hasAttribute('data-expanded');
        this.setExpanded(open);
        if (open) this.input.focus();
      });
      document.addEventListener('click', (e) => {
        if (!this.hasAttribute('data-expanded') || this.contains(e.target as Node)) return;
        if (!(window.getSelection()?.isCollapsed ?? true)) return;
        this.setExpanded(false);
      });
    }

    private setExpanded(open: boolean) {
      if (open && !matchMedia(WIDE).matches) return;
      if (open === this.hasAttribute('data-expanded')) return;
      const follow = this.nearLogEnd();
      this.toggleAttribute('data-expanded', open);
      const widen = this.q('.widen');
      const label = open ? 'Свернуть чат' : 'Развернуть чат';
      widen.setAttribute('aria-pressed', String(open));
      widen.setAttribute('aria-label', label);
      widen.title = label;
      if (!follow) return;
      // Messages re-wrap as the width animates: keep the newest one in view throughout.
      const panel = this.q('.panel');
      const keep = () => this.scrollLog();
      keep();
      panel.addEventListener('transitionend', keep, { once: true });
      requestAnimationFrame(keep);
    }

    /**
     * Grows the box with the question, up to a cap set in CSS (then it scrolls), and lets
     * the send button through only when there is something to send.
     */
    private syncInput = () => {
      const input = this.input;
      input.style.height = 'auto';
      input.style.height = `${input.scrollHeight + input.offsetHeight - input.clientHeight}px`;
      this.q<HTMLButtonElement>('.send').disabled = this.busy || !input.value.trim();
    };

    /**
     * Enter sends and Shift+Enter breaks the line, as in common chat apps. On touch
     * screens Enter breaks the line (the button sends). Ctrl/Cmd+Enter always sends.
     */
    private onKey = (e: KeyboardEvent) => {
      if (e.key !== 'Enter' || e.isComposing) return;
      const mod = e.ctrlKey || e.metaKey;
      if (!mod && (e.shiftKey || e.altKey || matchMedia('(pointer: coarse)').matches)) return;
      e.preventDefault();
      void this.send('message');
    };

    /** Keeps the sheet above the on-screen keyboard (iOS does not shrink the layout). */
    private fitViewport = () => {
      const vv = window.visualViewport;
      if (!vv) return;
      const below = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
      this.style.setProperty('--kb', `${below}px`);
      this.style.setProperty('--vvh', `${vv.height}px`);
    };

    private hadThread(): boolean {
      try {
        return localStorage.getItem(this.storageKey) !== null;
      } catch {
        return false;
      }
    }

    private rememberThread() {
      try {
        localStorage.setItem(this.storageKey, '1');
      } catch {
        // Private mode: the thread still loads on focus.
      }
    }

    private showSignIn() {
      const next = encodeURIComponent(location.pathname);
      this.q('.compose').hidden = true;
      const signin = this.querySelector<HTMLElement>('.signin');
      if (signin) {
        signin.hidden = false;
        this.q<HTMLAnchorElement>('.signin a').href = `/login/?next=${next}`;
      } else {
        this.notice(`<a href="/login/?next=${next}">Войдите</a>, чтобы задать вопрос репетитору.`);
      }
    }

    // --- shared -----------------------------------------------------------------------

    /** Loads the thread and the Markdown renderer once. False if the chat can't be used. */
    private ensureLoaded(): Promise<boolean> {
      this.loading ??= this.load();
      return this.loading;
    }

    private async load(): Promise<boolean> {
      try {
        const [thread, md] = await Promise.all([
          tutor.thread(this.kind, this.contextId),
          import('../lib/client-markdown'),
        ]);
        this.md = md;
        for (const m of thread.messages) this.addMessage(m.role, m.content);
        this.maxLevel = thread.max_hint_level;
        this.showLevel(thread.hint_level);
        this.showLeft(thread.messages_left);
        this.scrollLog();
        return true;
      } catch (e) {
        if (e instanceof ApiError && e.status === 401) {
          this.showSignIn();
        } else {
          this.notice('Не удалось загрузить диалог. Обновите страницу.');
          this.loading = undefined; // let the next focus or send try again
        }
        return false;
      }
    }

    private addMessage(role: string, content: string): HTMLElement {
      const li = document.createElement('li');
      li.className = role;
      const body = document.createElement('div');
      body.className = 'prose';
      if (role === 'user') body.textContent = content;
      else body.innerHTML = this.md?.renderUntrusted(content) ?? '';
      li.append(body);
      this.q('.log').append(li);
      return body;
    }

    /** Docked: the log scrolls on its own, keep its end in view. Inline: scroll the page. */
    private scrollLog(target?: HTMLElement) {
      const log = this.q('.log');
      if (this.docked) log.scrollTop = log.scrollHeight;
      else target?.scrollIntoView({ block: 'nearest' });
    }

    private nearLogEnd(): boolean {
      const log = this.q('.log');
      return log.scrollHeight - log.scrollTop - log.clientHeight < 48;
    }

    private async send(intent: 'message' | 'hint') {
      const input = this.input;
      const text = input.value.trim();
      if (this.busy || (intent === 'message' && !text)) return;
      this.setBusy(true);
      if (!(await this.ensureLoaded()) || !this.md) {
        this.setBusy(false);
        return;
      }
      this.notice('');
      const asked = this.addMessage('user', text || 'Дай, пожалуйста, подсказку.');
      let failed = false;
      input.value = '';
      this.syncInput();
      const md = this.md;
      const target = this.addMessage('assistant', '');
      target.parentElement?.classList.add('streaming');
      if (this.docked) this.scrollLog();
      let reply = '';
      let frame = 0;
      const paint = () => {
        frame = 0;
        // Follow the reply, unless the student scrolled up to reread something.
        const follow = this.docked && this.nearLogEnd();
        target.innerHTML = md.renderUntrusted(md.closedMathPrefix(reply));
        if (follow) this.scrollLog();
      };
      try {
        await tutor.send({ kind: this.kind, id: this.contextId, text, intent }, (ev) => {
          if (ev.event === 'meta') {
            this.showLevel(ev.data.hint_level);
            this.showLeft(ev.data.messages_left);
          } else if (ev.event === 'delta') {
            reply += ev.data.text;
            frame ||= requestAnimationFrame(paint);
          } else if (ev.event === 'error') {
            failed = true;
            this.notice(ERRORS[ev.data.detail] ?? ERRORS.tutor_unavailable!);
            if (ev.data.hint_level !== undefined) this.showLevel(ev.data.hint_level);
            if (ev.data.messages_left !== undefined) this.showLeft(ev.data.messages_left);
          }
        });
        if (frame) cancelAnimationFrame(frame);
        const follow = this.docked && this.nearLogEnd();
        target.innerHTML = md.renderUntrusted(reply);
        if (follow) this.scrollLog();
        if (!reply) target.parentElement?.remove();
        else this.rememberThread();
        if (failed && !reply) {
          // The server kept nothing of this turn: let the student resend it.
          asked.parentElement?.remove();
          input.value = text;
          this.syncInput();
        }
      } catch (e) {
        target.parentElement?.remove();
        if (!reply) asked.parentElement?.remove(); // a turn cut mid-stream is saved
        const detail = e instanceof ApiError ? e.detail : '';
        this.notice(ERRORS[detail] ?? 'Нет связи с сервером. Попробуйте ещё раз.');
        if (!text) return;
        input.value = text; // let the student resend
        this.syncInput();
      } finally {
        target.parentElement?.classList.remove('streaming');
        this.setBusy(false);
        if (!this.docked) target.scrollIntoView({ block: 'nearest' });
      }
    }

    private setBusy(busy: boolean) {
      this.busy = busy;
      const hint = this.querySelector<HTMLButtonElement>('.hint');
      if (hint) hint.disabled = busy;
      this.syncInput();
    }

    private showLevel(level: number | null) {
      const max = this.maxLevel;
      const el = this.q('.level');
      el.hidden = level === null;
      if (level !== null) el.textContent = `подсказка: ${level} из ${max}`;
      const hint = this.querySelector<HTMLButtonElement>('.hint');
      if (hint) hint.hidden = level !== null && level >= max;
    }

    private showLeft(left: number) {
      this.q('.left').textContent = left <= 10 ? `осталось ${left}` : '';
    }

    /** Fixed HTML only (no model output). */
    private notice(html: string) {
      const n = this.q('.notice');
      n.innerHTML = html;
      n.hidden = !html;
    }
  }

  customElements.define('tutor-chat', TutorChat);
</script>

<style>
  tutor-chat {
    display: block;
    margin: 1.5rem 0;
  }
  button {
    font: inherit;
    font-weight: 600;
    padding: 0.55rem 1rem;
    border: 0;
    border-radius: 8px;
    background: var(--accent);
    color: var(--surface);
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
  }
  .open,
  .secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .panel {
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  h2 {
    margin: 0;
    font-size: 1.1rem;
  }
  .level,
  .left {
    font-size: 0.8rem;
  }
  .intro {
    font-size: 0.875rem;
    margin: 0.25rem 0 0.75rem;
  }
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .log :global(li) {
    max-width: 92%;
    padding: 0.5rem 0.75rem;
    border-radius: 12px;
    overflow-wrap: anywhere;
  }
  .log :global(li.user) {
    align-self: flex-end;
    background: var(--accent-soft);
    white-space: pre-wrap;
  }
  .log :global(li.assistant) {
    align-self: flex-start;
    background: var(--bg);
    border: 1px solid var(--border);
  }
  .log :global(li.streaming:empty)::after,
  .log :global(li.streaming .prose:empty)::after {
    content: '…';
    color: var(--muted);
  }
  .log :global(p) {
    margin: 0.25rem 0;
  }
  .log :global(.katex-display) {
    margin: 0.4rem 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .notice {
    font-size: 0.925rem;
    margin: 0.75rem 0 0;
  }
  .compose {
    margin-top: 0.75rem;
  }
  /* One bordered composer: the growing question box with the send button in its corner.
     The button sits beside the text, not over it, so a long question never runs under it. */
  .box {
    display: flex;
    align-items: flex-end;
    gap: 0.25rem;
    padding: 0.3rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg);
  }
  .box:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  textarea {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    font-size: 1rem; /* ≥16px stops iOS zooming on focus */
    padding: 0.3rem 0.4rem 0.3rem 0.45rem;
    border: 0;
    outline: none; /* the box shows focus */
    background: transparent;
    color: var(--text);
    resize: none;
    max-height: 10rem; /* ~6 lines, then it scrolls */
    overflow-y: auto;
  }
  .send {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
  }
  .send:hover:not(:disabled) {
    background: var(--accent-strong);
  }
  .send:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .send:disabled {
    opacity: 1;
    background: var(--surface-2);
    color: var(--muted);
    cursor: default;
  }
  @media (pointer: coarse) {
    .send {
      width: 2.75rem; /* ≥40px tap target */
      height: 2.75rem;
    }
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  /* Theory pages: nothing to show until the counter appears. */
  .actions:not(:has(.hint)):has(.left:empty) {
    display: none;
  }
  .actions .left {
    margin-left: auto;
  }
  .actions .hint {
    padding: 0.3rem 0.8rem;
    font-size: 0.875rem;
  }

  /* --- docked (theory pages) ------------------------------------------------------- */
  [data-variant='docked'] {
    margin: 0;
  }
  [data-variant='docked'] .panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  [data-variant='docked'] .log {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.15rem;
  }
  /* Room to read the conversation once it starts. */
  .panel:has(.log li) .intro {
    display: none;
  }
  .motto {
    margin: 0.5rem 0 0.25rem;
    padding: 0.5rem 0.75rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--accent-soft);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .signin {
    margin: 0.75rem 0 0;
  }
  .signin .btn {
    width: 100%;
  }
  /* A wide chat must not stretch a reply into one long line. */
  [data-variant='docked'] .log :global(li) {
    max-width: min(92%, 40rem);
  }
  .widen,
  .close {
    margin-left: auto;
    padding: 0.2rem 0.55rem;
    background: transparent;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1;
  }
  .fab {
    position: fixed;
    right: var(--gutter);
